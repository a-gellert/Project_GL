[bootstrap]
main_collection = /main/main.collectionc
render = /builtins/render/default.renderc

[script]
shared_state = 1

[display]
width = 1920
height = 1080
high_dpi = 1
vsync = 1

[render]
clear_color_red = 0.62
clear_color_green = 0.47
clear_color_blue = 0.33
clear_color_alpha = 1

[input]
game_binding = /input/game.input_bindingc

[collection]
max_instances = 2048

[collection_proxy]
max_count = 4

[model]
max_count = 1024

[factory]
max_count = 64

[collectionfactory]
max_count = 64

[gui]
max_count = 16
max_animation_count = 512

[android]
input_method = HiddenInputField

[html5]
scale_mode = stretch
wasm_streaming = 1
show_fullscreen_button = 0
show_made_with_defold = 0

[project]
title = Project_GL
dependencies#0 = https://github.com/defold/extension-poki-sdk/archive/refs/heads/main.zip
dependencies#1 = https://github.com/Insality/druid/archive/refs/tags/1.2.1.zip
dependencies#2 = https://github.com/Insality/defold-event/archive/refs/tags/14.zip

