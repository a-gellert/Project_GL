#version 140

// Unlit-friendly low-poly shader: world-space normal for a fixed sun,
// view depth for cheap distance fog. No textures, colour comes from `tint`
// (palette entry chosen in modules/palette.lua).

in highp vec4 position;
in mediump vec3 normal;

out mediump vec3 var_normal;
out highp float var_depth;

uniform vs_uniforms
{
    highp mat4 mtx_world;
    highp mat4 mtx_view;
    highp mat4 mtx_proj;
};

void main()
{
    vec4 world_pos = mtx_world * vec4(position.xyz, 1.0);
    vec4 view_pos = mtx_view * world_pos;
    var_normal = normalize(mat3(mtx_world) * normal);
    var_depth = -view_pos.z;
    gl_Position = mtx_proj * view_pos;
}
